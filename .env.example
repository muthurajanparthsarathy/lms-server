# Server environment variables. Copy to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Gemini API key (used by controllers/geminiAIController.js and test.js).
GEMINI_API_KEY=

# ── Email (Resend only — there is no SMTP fallback) ───────────────────────
# utils/sendEmail.js sends every mail through Resend. Both variables are
# required; without either one, sendEmail() returns { success: false } and the
# server logs the reason at boot.
#
# RESEND_FROM_EMAIL must be an address on a domain VERIFIED at
# resend.com/domains. Resend rejects any other sender with a 403.
RESENDMAIL_API_KEY=
RESEND_FROM_EMAIL="SmartCliff <no-reply@smartcliff.in>"
