# Server environment variables. Copy to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Gemini API key (used by controllers/geminiAIController.js and test.js).
GEMINI_API_KEY=

# ── Profile pictures (Cloudinary) ─────────────────────────────────────────
# Avatars are stored in Cloudinary under lms/users/profile, using the
# CLOUDINARY_* credentials below. Supabase is no longer used for them.
#
# Optional: point picture-less users at your own default avatar instead of the
# neutral placeholder the server seeds automatically on first use. The URL MUST
# contain the text "default_profile_image" — that substring is how the code
# knows an avatar is the shared default and must never be deleted when one user
# changes their picture.
DEFAULT_PROFILE_IMAGE_URL=

# ── Backup (System Settings > Backup) ─────────────────────────────────────
# Destination connection string for "DB backup" runs, which copy the selected
# documents into a second database. Include the target database name in the
# path (…mongodb.net/backup?…). Leave unset to disable the "Backup database"
# option — local .zip backups do not need it.
BACKUP_MONGOURI=

# ── Email (Resend only — there is no SMTP fallback) ───────────────────────
# utils/sendEmail.js sends every mail through Resend. Both variables are
# required; without either one, sendEmail() returns { success: false } and the
# server logs the reason at boot.
#
# RESEND_FROM_EMAIL must be an address on a domain VERIFIED at
# resend.com/domains. Resend rejects any other sender with a 403.
RESENDMAIL_API_KEY=
RESEND_FROM_EMAIL="SmartCliff <no-reply@smartcliff.in>"

GEMINI_API_KEY=


# ── Live interactive compiler (Java / C / C++ / C#) ───────────────────────
# Programs run in the self-hosted compiler service (../compiler-service, warm
# Docker workers; start it with `docker compose up -d --build` in the project
# root). This server only needs its Redis. Leave empty to turn the compiler
# off (the page then says it is not set up).
COMPILER_REDIS_URL=redis://127.0.0.1:6379
# Must match the compiler service's COMPILER_QUEUE_PREFIX.
COMPILER_QUEUE_PREFIX=lms-compiler
COMPILER_MAX_SOURCE_BYTES=65536
COMPILER_MAX_INPUT_BYTES=4096
COMPILER_MAX_RUNS_PER_MINUTE=20
COMPILER_MAX_SESSIONS_PER_USER=1
COMPILER_MAX_QUEUE_LENGTH=50
# Optional: lets a monitoring probe read GET /compiler/health with the header
# x-compiler-health-token (otherwise a signed-in user is required).
COMPILER_HEALTH_TOKEN=
# Development only (ignored when NODE_ENV=production): run code without signing in.
COMPILER_ALLOW_ANONYMOUS=false
